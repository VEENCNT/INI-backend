<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>МедСити</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="mobile-container">
    {{> header}}

    <div class="form-container">
      <h1 class="page-title">Черновик</h1>

      <form action="{{#if isDraftCreated}}/biochemicalIndicatorDraft/form{{else}}/biochemicalIndicatorDraft/next{{/if}}" 
            method="POST" 
            class="draft-form">
          
        {{#if isDraftCreated}}
          <input type="hidden" name="indicatorId" value="{{indicatorId}}">
        {{/if}}
          
        <div class="form-section">
          <h2 class="section-title">Медиа</h2>
          
          <label class="field-label">Изображение</label>
          <input type="file" id="image-input" name="image" accept="image/*" hidden>
          <div class="image-upload-box">
            <span class="upload-placeholder">Изображение не загружено</span>
            <img class="image-preview" src="/images/placeholder.png" alt="Изображение не загружено">
          </div>
          <label for="image-input" class="btn-purple btn-full">
            Загрузить &darr;
          </label>

          <label class="field-label">Видео</label>
          <input type="file" id="video-input" name="video" accept="video/*" hidden>
          <div class="video-upload-box">
            <span class="upload-placeholder">Видео не загружено</span>
            <video class="video-preview" src="/videos/placeholder.mp4" autoplay loop muted playsinline></video>
          </div>
          <label for="video-input" class="btn-purple btn-full">
            Загрузить &darr;
          </label>
        </div>

        <div class="form-section">
          <h2 class="section-title">Заголовки</h2>
          
          <div class="input-group">
            <label class="field-label">Название</label>
            <input type="text" name="title" class="form-input" placeholder="Например: Крайне низкий Альбумин" value="{{title}}" required>
          </div>

          {{#if isDraftCreated}}
            <div class="input-group">
              <label class="field-label">Описание</label>
              <textarea name="description" class="form-textarea" placeholder="Например: Серьезный дефицит основного белка крови...">{{description}}</textarea>
            </div>
          {{/if}}
        </div>

        {{#if isDraftCreated}}
        <div class="form-section">
          <h2 class="section-title">Поля по теме</h2>

          <div class="input-group">
            <label class="field-label">Нижняя граница содержания в крови, eд.</label>
            <input type="number" name="lowerReferenceLimit" class="form-input" placeholder="Например: 50" required>
          </div>

          <div class="input-group">
            <label class="field-label">Верхняя граница содержания в крови, ед.</label>
            <input type="number" name="upperReferenceLimit" class="form-input" placeholder="Например: 65" required>
          </div>
        </div>
        {{/if}}

        <button type="submit" class="btn-purple btn-full">
          {{#if isDraftCreated}}Отправить{{else}}Далее{{/if}}
        </button>
      </form>
    </div>

    {{> navigation}}
  </div>
</body>
</html>