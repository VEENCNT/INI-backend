<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>МедСити — Биохимические показатели</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="mobile-container">
    {{> header}}

    <div class="grid-container">
      <h1 class="page-title">Биохимические показатели</h1>

      <form action="/grid" method="GET" class="search-card" id="search-form">
        <div class="search-title">Количество вещества в крови</div>
        <div class="search-subtitle">(значение в произвольных единицах измерения)</div>
        
        <input type="number" name="bloodSubstanceConcentration" class="form-input" placeholder="Например: 35" style="margin-bottom: 0;" value="{{searchedConcentrationValue}}">
      </form>

      <button type="submit" form="search-form" class="btn-purple btn-full" style="margin-bottom: 27px;">Поиск</button>

      <div class="indicators-grid">
        {{#each biochemicalIndicators}}
        <div class="indicator-card">
          <div class="card-image" style="background-image: url('{{this.indicatorImageUrl}}');"></div>
          
          <div class="card-body">
            <h3 class="card-title">{{this.indicatorTitle}}</h3>
            <span class="card-range"><span class="card-indicator">{{this.indicatorName}}: </span>{{this.lowerReferenceLimit}}-{{this.upperReferenceLimit}} {{this.measurementUnit}}</span>
            
            <div class="card-footer">
              <button type="button" 
                      class="likes-pill {{#if this.isLiked}}is-liked{{/if}}" 
                      data-indicator-id="{{this.indicatorId}}">
                <img src="/images/heart.svg" alt="Сердце">
                <span class="card-likes">{{this.likesCount}}</span>
              </button>
              
              <a href="/feed?indicatorId={{this.indicatorId}}" class="btn-outline">Подробнее</a>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{> bottom_nav}}
  </div>
</body>
</html>