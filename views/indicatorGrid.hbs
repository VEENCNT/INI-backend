<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>МедСити</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="mobile-container">
    {{> header}}

    <div class="grid-container">
      <h1 class="page-title">Биохимические показатели</h1>

      <form action="/indicatorGrid" method="GET" class="search-card" id="search-form">
        <div class="search-title">Количество вещества в крови, ед.</div>
        <div class="range-wrapper">
          <span class="range-labels">0</span>
          <input type="range" name="indicatorConcentration" class="form-range" min="0" max="5000" step="1" value="{{searchedConcentration}}">
          <span class="range-labels">5000</span>
        </div>
      </form>

      <button type="submit" form="search-form" class="btn-purple btn-full" style="margin-bottom: 27px;">Поиск</button>

      <div class="indicators-grid">
        {{#each biochemicalIndicators}}
        <div class="indicator-card">
          <div class="card-image" style="background-image: url('{{this.imageUrl}}');"></div>
          
          <div class="card-body">
            <h3 class="card-title">{{this.indicatorTitle}}</h3>
            <span class="card-range"><span class="card-indicator">Показания: </span>{{this.lowerReferenceLimit}}-{{this.upperReferenceLimit}} ед.</span>
            
            <div class="card-footer">
              <button type="button" 
                      class="likes-pill {{#if this.isLiked}}is-liked{{/if}}" 
                      data-indicator-id="{{this.indicatorId}}">
                <img src="/images/heart.svg" alt="Сердце">
                <span class="card-likes">{{this.likesCount}}</span>
              </button>
              
              <a href="/indicatorFeed?indicatorId={{this.indicatorId}}" class="btn-outline">Подробнее</a>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{> navigation}}
  </div>
</body>
</html>