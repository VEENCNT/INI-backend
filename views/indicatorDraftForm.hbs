<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>МедСити</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="mobile-container">
    {{> header}}

    <div class="form-container">
      <h1 class="page-title">Черновик</h1>

      <form action="/indicatorDraftForm" method="POST" enctype="multipart/form-data" class="draft-form">
        <div class="form-section">
          <h2 class="section-title">Медиа</h2>
          
          <label class="field-label">Изображение</label>
          <input type="file" id="image-input" name="image" accept="image/*" hidden required>
          <div class="image-upload-box">
            <span class="upload-placeholder">Изображение не загружено</span>
          </div>
          <label for="image-input" class="btn-purple btn-full">
            Загрузить &darr;
          </label>

          <label class="field-label">Видео</label>
          <input type="file" id="video-input" name="video" accept="video/*" hidden required>
          <div class="video-upload-box">
            <span class="upload-placeholder">Видео не загружено</span>
          </div>
          <label for="video-input" class="btn-purple btn-full">
            Загрузить &darr;
          </label>
        </div>

        <div class="form-section">
          <h2 class="section-title">Заголовки</h2>
          
          <div class="input-group">
            <label class="field-label">Название</label>
            <input type="text" name="title" class="form-input" placeholder="Например: Крайне низкий Альбумин">
          </div>

          <div class="input-group">
            <label class="field-label">Описание</label>
            <textarea name="description" class="form-textarea" placeholder="Например: Серьезный дефицит основного белка крови..."></textarea>
          </div>
        </div>

        <div class="form-section">
          <h2 class="section-title">Поля по теме</h2>

          <div class="input-group">
            <label class="field-label">Нижняя граница содержания в крови, eд.</label>
            <input type="number" name="lowerLimit" class="form-input" placeholder="Например: 50">
          </div>

          <div class="input-group">
            <label class="field-label">Верхняя граница содержания в крови, ед.</label>
            <input type="number" name="upperLimit" class="form-input" placeholder="Например: 65">
          </div>
        </div>
      </form>
    </div>

    {{> navigation}}
  </div>
</body>
</html>